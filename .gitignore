# 忽略数据文件夹（只保留结构）
!data/input/.gitkeep
!data/output/.gitkeep

# 忽略 Python 缓存
__pycache__/
*.pyc

# 忽略环境配置
.env
venv/
.venv/
chroma_db
.vscode/

# 旧版用户目录（当前运行时数据统一存储在 data/<user>/...）
users/
src/backend/node_modules/
src/frontend/node_modules/
src/frontend/dist/
src/frontend/.vite/
src/frontend/.env.local
src/backend/.env
src/backend/*.log
src/backend/logs/
